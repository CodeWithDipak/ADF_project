{
	"name": "DataTransformationForSilverLayer",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SQLDataBronzeLayer",
						"type": "DatasetReference"
					},
					"name": "FactBooking"
				},
				{
					"dataset": {
						"referenceName": "OnPremDimAirline",
						"type": "DatasetReference"
					},
					"name": "DimAirline"
				},
				{
					"dataset": {
						"referenceName": "OnPremDimFlight",
						"type": "DatasetReference"
					},
					"name": "DimFlight"
				},
				{
					"dataset": {
						"referenceName": "OnPremDimPassenger",
						"type": "DatasetReference"
					},
					"name": "DimPassenger"
				},
				{
					"dataset": {
						"referenceName": "GitDataDimAirport",
						"type": "DatasetReference"
					},
					"name": "DimAirport"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ADLSBronze",
						"type": "LinkedServiceReference"
					},
					"name": "FactBookingSilver"
				},
				{
					"linkedService": {
						"referenceName": "ADLSBronze",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirlineSilver"
				},
				{
					"linkedService": {
						"referenceName": "ADLSBronze",
						"type": "LinkedServiceReference"
					},
					"name": "DimFlightSilver"
				},
				{
					"linkedService": {
						"referenceName": "ADLSBronze",
						"type": "LinkedServiceReference"
					},
					"name": "DimPassengerSilver"
				},
				{
					"linkedService": {
						"referenceName": "ADLSBronze",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirportSilver"
				}
			],
			"transformations": [
				{
					"name": "TypeCastFactBooking"
				},
				{
					"name": "filterFactBooking"
				},
				{
					"name": "UpperCountry"
				},
				{
					"name": "ChangeColNameDimFlight"
				},
				{
					"name": "filterAge"
				},
				{
					"name": "DerivedMale"
				},
				{
					"name": "DerivedFemale"
				},
				{
					"name": "firstName"
				},
				{
					"name": "lastName"
				},
				{
					"name": "alterRowFactBooking"
				},
				{
					"name": "alterRowDimAirline"
				},
				{
					"name": "alterRowDimFlight"
				},
				{
					"name": "alterRowDimPassenger"
				},
				{
					"name": "alterRowDimAirport"
				}
			],
			"scriptLines": [
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as decimal(10,2),",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> FactBooking",
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_time as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimFlight",
				"source(output(",
				"          passenger_id as short,",
				"          full_name as string,",
				"          gender as string,",
				"          age as short,",
				"          country as string,",
				"          state as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimPassenger",
				"source(output(",
				"          airport_id as short,",
				"          airport_name as string,",
				"          city as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> DimAirport",
				"FactBooking derive(ticket_cost = round(ticket_cost)) ~> TypeCastFactBooking",
				"TypeCastFactBooking filter(checkin_status == \"Yes\") ~> filterFactBooking",
				"DimAirline derive(country = upper(country)) ~> UpperCountry",
				"DimFlight select(mapColumn(",
				"          flight_id,",
				"          flight_number,",
				"          departure_timestamp = departure_time,",
				"          arrival_timestamp = arrival_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ChangeColNameDimFlight",
				"DimPassenger filter(age > 28) ~> filterAge",
				"filterAge derive(gender = regexReplace(gender,\"M\",\"Male\")) ~> DerivedMale",
				"DerivedMale derive(gender = regexReplace(gender, \"F\", \"Female\")) ~> DerivedFemale",
				"DerivedFemale derive(first_name = split(full_name,\" \")[1]) ~> firstName",
				"firstName derive(last_name = split(full_name, \" \")[2]) ~> lastName",
				"filterFactBooking alterRow(upsertIf(1==1)) ~> alterRowFactBooking",
				"UpperCountry alterRow(upsertIf(1==1)) ~> alterRowDimAirline",
				"ChangeColNameDimFlight alterRow(upsertIf(1==1)) ~> alterRowDimFlight",
				"lastName alterRow(upsertIf(1==1)) ~> alterRowDimPassenger",
				"DimAirport alterRow(upsertIf(1==1)) ~> alterRowDimAirport",
				"alterRowFactBooking sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBookings',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['booking_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FactBookingSilver",
				"alterRowDimAirline sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirline',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['airline_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DimAirlineSilver",
				"alterRowDimFlight sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimFlight',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['flight_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DimFlightSilver",
				"alterRowDimPassenger sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimPassenger',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['passenger_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DimPassengerSilver",
				"alterRowDimAirport sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirport',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['airport_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DimAirportSilver"
			]
		}
	}
}