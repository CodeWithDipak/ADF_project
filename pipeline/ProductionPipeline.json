{
	"name": "ProductionPipeline",
	"properties": {
		"activities": [
			{
				"name": "MigrateOnPremData",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "MigrateOnPremData",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "MigrateGitAPIData",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "MigrateOnPremData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "MigrateGitAPIData",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "SQLDataLoading",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "MigrateGitAPIData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "SQLDataLoading",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "FailureAlert",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "CallbackURL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@activity('CallbackURL').output.value",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"pipeline_name\": \"@{pipeline().Pipeline}\",\n    \"run_id\": \"@{pipeline().RunId}\",\n    \"status\": \"@{activity('SQLDataLoading').Status}\",\n    \"error\": \"@{if(equals(activity('SQLDataLoading').Status, 'Failed'), activity('SQLDataLoading').error.message, 'No Error')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CallbackURL",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SQLDataLoading",
						"dependencyConditions": [
							"Succeeded",
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-adf-project.vault.azure.net/secrets/LogicAppCallbackUrl?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-08-11T08:57:28Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}